# ============================================
# FoodFlow Server Configuration (.env.example)
# Copy this file to .env and fill in your values
# ============================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5500

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=foodflow
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=foodflow_change_this_to_a_long_random_secret_key_for_production
JWT_EXPIRES_IN=7d

# Rate Limiting
REGISTER_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
MEAL_WRITE_RATE_LIMIT=60
RESERVATION_WRITE_RATE_LIMIT=30

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Set true to demonstrate the payment flow locally without bKash merchant credentials.
BKASH_DEMO_MODE=false

# bKash Tokenized Checkout (sandbox). Keep all credentials on the server.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=your_sandbox_app_key
BKASH_APP_SECRET=your_sandbox_app_secret
BKASH_USERNAME=your_sandbox_username
BKASH_PASSWORD=your_sandbox_password
# This must be publicly reachable over HTTPS for the bKash redirect flow.
BKASH_CALLBACK_URL=https://your-domain.example/api/payments/bkash/callback
CLIENT_PAYMENT_RESULT_URL=http://localhost:5500/payment-result.html
